{
  "name": "scribbot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot that records RPG sessions, transcribes them with Whisper, and summarizes them into FoundryVTT.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "register": "tsx scripts/register-commands.ts",
    "summarize": "tsx scripts/summarize-session.ts",
    "merge": "tsx scripts/merge-sessions.ts",
    "schemas": "tsx scripts/export-schemas.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@discordjs/voice": "^0.19.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/websocket": "^11.3.4",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "openai": "^7.43.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
