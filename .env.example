# ---------- Discord ----------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one guild instantly (otherwise global, ~1h propagation)
DISCORD_GUILD_ID=

# ---------- Storage ----------
# Relative paths resolve from the repo root
DATA_DIR=./data
# Campaign context/glossary fed to Whistle (names) and the summarizer (lore)
CAMPAIGN_DIR=./campaign

# ---------- Bot API (for the Foundry module) ----------
API_HOST=127.0.0.1
API_PORT=7420
# Shared secret; paste the same value into the Foundry module settings
API_TOKEN=change-me
# Comma-separated origins allowed to call the API (your Foundry URL)
FOUNDRY_ORIGINS=http://localhost:30000

# ---------- Headless Foundry client (optional) ----------
# Have the bot join Foundry itself, in a headless browser, as the module's bridge user, so no
# one has to keep a browser open. Setup: create a Foundry player (e.g. "ScribBot") with a
# password, and as GM set ScribBot Bridge's "Bridge user" setting to it.
#   off     - a person's browser is the bridge (default)
#   session - join when a recording starts, leave once the chat log is uploaded; also join
#             briefly to import a summary
#   always  - stay joined while the bot runs
FOUNDRY_HEADLESS=off
# Foundry's base URL (default: the first FOUNDRY_ORIGINS entry). Must also be in FOUNDRY_ORIGINS.
FOUNDRY_URL=
FOUNDRY_USER=ScribBot
FOUNDRY_PASSWORD=
# Browser to drive: msedge (default on Windows), chrome, chromium (run
# `npx playwright-core install chromium` in bot/), or a path to a Chromium-based browser.
FOUNDRY_BROWSER=
# The bot's API as that browser reaches it (default: http://127.0.0.1:API_PORT)
FOUNDRY_BOT_URL=
# After /scrib stop, how long the summary waits for Foundry's chat log before going without it
FOUNDRY_CHATLOG_WAIT_SECONDS=120
# Post in Foundry's chat when ScribBot joins (and why) and before it leaves (true/false)
FOUNDRY_ANNOUNCE=true

# ---------- Console (console/, started by start-console.ps1) ----------
# Port for the management page: sessions, monitoring and these settings (bound to 127.0.0.1).
# The older MONITOR_PORT is still read when this is blank.
CONSOLE_PORT=7422
# Where the Console keeps daily copies of the bot's log (scribbot-YYYY-MM-DD.log, 14 days), so
# the lines before a crash survive it. Default: <DATA_DIR>/logs. Turn off with -NoLogFile.
MONITOR_LOG_DIR=

# ---------- Transcription worker (Cactus Whistle) ----------
WORKER_URL=http://127.0.0.1:7421
# en de fr es it nl pl, or blank to auto-detect per clip
STT_LANGUAGE=en
# Optional path to a local or fine-tuned whistle.cact (default: downloaded from Hugging Face on first use)
WHISTLE_WEIGHTS=
# Speech-to-text engine: whistle (17 MB, CPU, default) or whisper (OpenAI Whisper via
# faster-whisper; much more accurate). Whisper needs: pip install -e ".[whisper,cuda]" in worker/
# (or ".[whisper]" for CPU only). Whisper also supports far more languages than Whistle.
STT_ENGINE=whistle
# Whisper model (downloaded on first use; large-v3 is about 3 GB)
WHISPER_MODEL=large-v3
# cuda (NVIDIA GPU, e.g. RTX) or cpu
WHISPER_DEVICE=cuda
# Optional precision override; blank = float16 on cuda, int8 on cpu
WHISPER_COMPUTE_TYPE=
# Short-clip tuning (Whisper only). Beam search width (1 = greedy, fastest).
WHISPER_BEAM_SIZE=5
# Hotwords sent per clip (party, then glossary, then Foundry actors; 0 = none), and none for
# clips shorter than this many seconds. Long lists make Whisper write names instead of speech.
WHISPER_MAX_HOTWORDS=30
WHISPER_HOTWORDS_MIN_SECONDS=1.5
# Check each clip for speech on the CPU (Silero VAD) and skip silent ones. Threshold 0..1.
WHISPER_VAD=true
WHISPER_VAD_THRESHOLD=0.5
# Drop a clip that is only "thank you", "you", "bye"... when it's shorter than this many seconds AND
# decoded with mean word confidence below the second value (Whisper only; 0 = keep them all).
WHISPER_FILLER_MAX_SECONDS=2.0
WHISPER_FILLER_MAX_PROBABILITY=0.7
# On start, re-queue clips from sessions touched in the last N hours that have audio but no text (0 = off).
WORKER_RECOVER_HOURS=12
# After this many model errors in a row (e.g. a CUDA fault) reload the model; if that fails the worker
# exits so start-worker.ps1 restarts it (0 = never reload).
WORKER_RELOAD_AFTER_FAILURES=5
# Log a clip that has been transcribing longer than this many seconds (0 = never).
WORKER_SLOW_CLIP_SECONDS=60

# ---------- Summarizer ----------
# anthropic | xai | openai-compatible | gemini | vertex-ai | azure-openai | bedrock
# | codex | antigravity | claude-code | grok-cli
# codex, antigravity, claude-code and grok-cli run the OpenAI Codex CLI (`codex`), Google Antigravity
# CLI (`agy`), Claude Code (`claude`) or the xAI Grok CLI (`grok`), signed in with your own ChatGPT,
# Google, Claude or Grok account,
# instead of calling an API with a key.
LLM_PROVIDER=anthropic
# Leave blank for the provider default (anthropic: claude-opus-5-5, xai: grok-4,
# codex: the model in Codex's own config, antigravity: gemini-3.8-flash; `agy models` lists more;
# claude-code / grok-cli: the model in that CLI's own settings)
LLM_MODEL=
ANTHROPIC_API_KEY=
# Any endpoint speaking the Anthropic Messages API (gateway, proxy); blank = https://api.anthropic.com
ANTHROPIC_BASE_URL=
XAI_API_KEY=
# blank = https://api.x.ai/v1
XAI_BASE_URL=
# For openai-compatible: any server speaking OpenAI Chat Completions, up to /v1 (OpenAI, Mistral,
# DeepSeek, Groq, OpenRouter, Ollama, LM Studio, vLLM...)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
# For gemini (Google AI Studio key; blank model = gemini-3.8-flash). Vertex AI uses it only in express mode.
GEMINI_API_KEY=
# blank = https://generativelanguage.googleapis.com
GOOGLE_GEMINI_BASE_URL=
# For vertex-ai: the project, a location (blank = global), and a service account key file
# (blank = application default credentials from `gcloud auth application-default login`)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
# blank = the location's Vertex AI endpoint
GOOGLE_VERTEX_BASE_URL=
# For azure-openai: the resource endpoint and key; LLM_MODEL is the deployment name.
# For Microsoft Entra ID, leave the key blank and set an Authorization header in LLM_HEADERS.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# blank = 2024-10-21
OPENAI_API_VERSION=
# For bedrock: LLM_MODEL is a model id or inference profile. Credentials: a Bedrock API key, or a
# profile from ~/.aws/config (blank = the AWS default credential chain).
AWS_REGION=
AWS_PROFILE=
AWS_BEARER_TOKEN_BEDROCK=
# blank = the region's Bedrock Runtime endpoint
AWS_ENDPOINT_URL_BEDROCK_RUNTIME=
# API providers only, sent as written. Extra HTTP headers on every request, as
# "Name: value; Name2: value2" or a JSON object, e.g. HTTP-Referer: https://example.org; X-Title: ScribBot
# (OpenRouter), api-key: <key> (Azure OpenAI), or a gateway's Authorization header (then no API key needed).
LLM_HEADERS=
# Extra request-body fields, as a JSON object in the provider's own field names, e.g.
# {"temperature": 0.3} or {"max_completion_tokens": 32000, "reasoning_effort": "high"}.
# They override ScribBot's defaults; model, messages and the output format stay ScribBot's.
LLM_REQUEST_OPTIONS=
# For the CLI providers: the CLI to run when it isn't on PATH as `codex` / `agy` / `claude` / `grok`
LLM_CLI_PATH=
# Minutes of transcript per extraction chunk
SUMMARY_CHUNK_MINUTES=25
# Summarize every session automatically after transcription (sends the transcript to the
# LLM above). Off by default: sessions end at a saved transcript (transcript.md) and only
# /scrib summarize sends one to the LLM.
AUTO_SUMMARIZE=false

# ---------- Audio retention ----------
# true: each clip is transcribed live as soon as the speaker pauses, and its WAV is deleted once the
# text is saved. Saves disk space, but sessions can't be re-transcribed later.
DELETE_AUDIO_AFTER_TRANSCRIBE=true
# When audio is kept: delete it this many days after a session is summarized (0 = keep forever)
AUDIO_RETENTION_DAYS=14
# Sessions trashed from the Console wait in DATA_DIR/trash this many days (0 = until emptied by hand)
TRASH_RETENTION_DAYS=14
# The Console says how long a session will be kept before moving it to the trash (true/false;
# its "Don't show this again" box sets false)
TRASH_CONFIRM=true

# ---------- Recovery and logs ----------
# After a crash or restart, rejoin the voice channel of a session that was recording less than this
# many minutes ago and keep recording it on the same clock (0 = never resume; the session is failed).
RESUME_WINDOW_MINUTES=30
# Post one warning in the text channel when transcription falls this many minutes behind (0 = never)
BACKLOG_WARN_MINUTES=10
# The bot writes DATA_DIR/logs/bot-YYYY-MM-DD.log and keeps this many days (0 = no log files).
# The worker writes worker-YYYY-MM-DD.log beside it with the same retention.
LOG_RETENTION_DAYS=14
